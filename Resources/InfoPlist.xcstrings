{
  "sourceLanguage": "de",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Fotos und Videos direkt in einen Chat aufnehmen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can take photos and videos directly into a chat."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu deinem HomeThread-Server im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection to your HomeThread server on your home network."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du deinen aktuellen Ort in einem Chat festhalten kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can save your current location in a chat."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du deinen aktuellen Ort in einem Chat festhalten kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can save your current location in a chat."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Sprachnotizen aufnehmen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can record voice notes."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Fotos und Videos aus einem Chat in deiner Fotomediathek sichern kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can save photos and videos from a chat to your photo library."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Fotos und Videos in einem Chat ablegen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can add photos and videos to a chat."
          }
        }
      }
    }
  },
  "version": "1.0"
}