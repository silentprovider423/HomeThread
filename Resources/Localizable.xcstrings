    "Alles bleibt auf deinem Server. Auf diesem Gerät werden die lokalen Daten gelöscht; noch nicht abgeglichene Änderungen gehen verloren.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf deinem Server. Auf diesem Gerät werden die lokalen Daten gelöscht; noch nicht abgeglichene Änderungen gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your server. The local data on this device will be deleted; changes that haven't synced yet will be lost."
          }
        }
      }
    },
    "Alles liegt zuerst auf diesem Gerät. Bei Verbindung gleicht die App alle 15 Sekunden mit deinem Server ab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles liegt zuerst auf diesem Gerät. Bei Verbindung gleicht die App alle 15 Sekunden mit deinem Server ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is saved on this device first. While connected, the app syncs with your server every 15 seconds."
          }
        }
      }
    },
