    "HomeThread ist ein unabhängiges Open-Source-Projekt (GPLv3-Lizenz). Es verschickt nichts an andere – Chats und Gruppen sind Notiz-Räume auf deinem eigenen Server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeThread ist ein unabhängiges Open-Source-Projekt (GPLv3-Lizenz). Es verschickt nichts an andere – Chats und Gruppen sind Notiz-Räume auf deinem eigenen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeThread is an independent open-source project (GPLv3 license). It never sends anything to other people – chats and groups are note rooms on your own server."
          }
        }
      }
    },
